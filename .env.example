# DivineLines configuration.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.

# ---------------------------------------------------------------- secrets
# The-Odds-API key (https://the-odds-api.com). Without it the platform still
# runs: historical soccer prices come from football-data.co.uk, but no live
# odds are fetched and the +EV scanner has nothing to price against.
ODDS_API_KEY=

# ------------------------------------------------------------------ modes
# research = experiments and backtests; live = current data and predictions.
DL_MODE=research
DL_LOG_LEVEL=INFO
DL_LOG_JSON=0
# Serve only from cache; never make a network request.
DL_OFFLINE=0

# ---------------------------------------------------------------- betting
DL_BANKROLL=1000
DL_KELLY_FRACTION=0.25          # fractional Kelly (0.10 / 0.25 / 0.50 / 1.00)
DL_MAX_STAKE_PCT=0.02           # cap on a single selection
DL_MAX_SLATE_EXPOSURE_PCT=0.10  # cap across one day's slate
DL_MAX_GAME_EXPOSURE_PCT=0.03   # cap across one game (correlation control)
DL_MAX_TEAM_EXPOSURE_PCT=0.04   # cap across one team
DL_MIN_EDGE=0.02                # minimum edge over the no-vig market
DL_MIN_EDGE_SCORE=4.0           # minimum edge-quality score, 0-10
DL_MIN_DECIMAL_ODDS=1.20
DL_MAX_DECIMAL_ODDS=15.0
DL_MODEL_OUTLIER_THRESHOLD=0.25 # disagreement above this is treated as model error

# ----------------------------------------------------------------- models
DL_RANDOM_SEED=42
DL_TEST_FRACTION=0.20
DL_CALIBRATION=isotonic         # isotonic | platt | none
DL_SHRINKAGE_PRIOR_GAMES=12     # games at which current form outweighs the prior
DL_ELO_SEASON_REGRESSION=0.75   # rating carried across a season boundary
DL_ELO_K_NBA=20
DL_ELO_K_SOCCER=20

# ---------------------------------------------------------------- sources
DL_ODDS_REGIONS=us,uk,eu
DL_ODDS_MAX_CALLS=8             # hard cap on odds-API calls per run
DL_HTTP_TIMEOUT=20
DL_HTTP_RETRIES=3
DL_HTTP_MIN_INTERVAL=0.75       # polite delay between requests to one host

# Freshness budgets, in seconds, after which data is flagged stale.
DL_TTL_ODDS=600
DL_TTL_INJURIES=21600
DL_TTL_LINEUPS=2700
DL_TTL_SCHEDULE=43200

# Soccer seasons default to the last nine, ending with the current one, and
# roll forward on their own. Override only to pin a specific range.
# DL_SOCCER_SEASONS=2223,2324,2425,2526,2627
